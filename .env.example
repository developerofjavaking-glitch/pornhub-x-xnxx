# Copy to .env for local `docker run --env-file .env` usage.
# On Render, set these in the service's Environment tab instead.
#
# Only BOT_TOKEN is truly required. ADMIN_ID is required to use /admin.
# Everything else below is optional and has a sensible default - see README
# for the full list, including DATA_DIR / PORT / ENABLE_KEEPALIVE, which are
# auto-configured and don't need to be set at all in normal use.

# --- Required ---
BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather

# --- Admin / Owner ---
ADMIN_ID=7453801393
OWNER_LINK=https://t.me/King_Boom_69
CHANNEL_LINK=https://t.me/your_channel

# --- Branding ---
BOT_NAME=Boom Host Bot

# --- Behaviour ---
MAX_FILES_PER_USER=3
MAX_UPLOAD_MB=1
